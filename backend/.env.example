# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file.

# Your Anthropic API key (get one at console.anthropic.com).
# Leave blank to run in MOCK mode (no real API calls, canned responses).
ANTHROPIC_API_KEY=

# Recognition model. Haiku is the cost-effective choice for SnapShop.
SNAPSHOP_MODEL=claude-haiku-4-5-20251001

# Set to "true" to force mock mode even if a key is present (useful for tests/demos).
MOCK_MODE=false

# Supabase/Postgres connection string (optional). Leave blank to run entirely
# on the built-in seed seller data — the app works fully offline either way,
# and automatically falls back to the seed data if this is unreachable.
# Get this from the Supabase dashboard: click "Connect" (top toolbar) -> the
# "Direct" tab -> pick "Session pooler" mode -> copy the URI and fill in your
# DB password in place of [YOUR-PASSWORD].
DATABASE_URL=
